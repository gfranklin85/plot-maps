# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# IDE local state
.claude/

# Cesium static runtime assets — copied from node_modules at build time
# by scripts/copy-cesium-assets.mjs. Don't commit them; the script
# regenerates on every build (locally and on Vercel).
/public/cesium/

# Local parcel / property-data source files. These can be huge (Kings County
# parcel .dbf is ~1.4GB). They never belong in git. Property data adapters
# read from /data/* by convention; the path is configurable via env vars in
# production where needed.
/data/
